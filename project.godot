; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Torneio Medieval"
run/main_scene="res://game/scenes/common/principal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Jogador="*res://game/scripts/services/servico_jogador.gd"
Nuvem="*res://game/scripts/services/servico_nuvem.gd"
Notificacoes="*res://game/scripts/services/servico_notificacoes.gd"
Metricas="*res://game/scripts/services/servico_metricas.gd"
Registro="*res://game/scripts/services/registro_erros.gd"
Acessibilidade="*res://game/scripts/presentation/acessibilidade.gd"
Anuncios="*res://game/scripts/services/servico_anuncios.gd"
Fluxo="*res://game/scripts/presentation/fluxo.gd"
Audio="*res://game/scripts/presentation/audio/servico_audio.gd"
Depuracao="*res://game/scenes/common/depuracao.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://game/i18n/textos.pt_BR.translation", "res://game/i18n/textos.en.translation")
locale/fallback="pt_BR"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
