; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Torneio Medieval"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://game/scenes/arena/arena.tscn"
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[internationalization]

locale/translations=PackedStringArray("res://game/i18n/textos.pt_BR.translation", "res://game/i18n/textos.en.translation")
locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
