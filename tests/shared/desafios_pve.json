{
	"versao": 1,
	"descricao": "Desafios especiais do PvE (game/scripts/rules/pve.gd: aplicar_desafios e ajustar_perfil), calculados a mao. Porcentagens em inteiros (x * pct / 100, truncado). O servidor (TypeScript) roda os mesmos casos. perfil_rival: RegraPve.perfil_do_rival(ia, rival) = perfil + ajuste_campeao (se campeao) + perfil_ajuste do rival; chaves com _ sao notas e nao entram (esperado null = ausente).",
	"defs": {
		"uma_chance": { "tentativas": 1 },
		"cavalo_emprestado": { "cavalo": { "velocidade": 55, "folego": 50, "temperamento": 30 }, "gasta_folego": false },
		"sem_escudo": { "remover_pecas": ["escudo"], "ambos": true },
		"chuva": { "galope_janela_pct": 70, "visual": "chuva" },
		"noturna": { "mira_oscilacao_pct": 200, "ia_erro_mira_pct": 150, "visual": "noite" }
	},
	"base": {
		"cfg": { "galope": { "galope": { "janela_base_ms": 70, "janela_por_temperamento_milesimos": 1000, "janela_max_ms": 180, "compasso_ms": 500 } }, "mira": { "oscilacao": { "amplitude_px": 3 } } },
		"lado_jogador": { "cavalo": { "velocidade": 40, "folego": 40, "temperamento": 40 }, "equipamento": { "escudo": { "defesa": 5 }, "lanca": { "poder": 5 } } },
		"lado_rival": { "cavalo": { "velocidade": 60, "folego": 60, "temperamento": 60 }, "equipamento": { "escudo": { "defesa": 9 }, "elmo": { "defesa": 16 } } },
		"perfil_rival": { "erro_mira_px": 9, "reacao_media_ms": 190, "zona_preferida": "peito" }
	},
	"casos": [
		{ "nome": "sem desafio nao muda nada", "desafios": [], "esperado": {} },
		{ "nome": "chuva encolhe a janela", "desafios": ["chuva"],
			"esperado": { "cfg.galope.galope.janela_base_ms": 49, "cfg.galope.galope.janela_por_temperamento_milesimos": 700, "cfg.galope.galope.janela_max_ms": 126, "cfg.galope.galope.compasso_ms": 500 } },
		{ "nome": "noturna treme a mira e piora a IA", "desafios": ["noturna"],
			"esperado": { "cfg.mira.oscilacao.amplitude_px": 6, "perfil_rival.erro_mira_px": 13, "perfil_rival.reacao_media_ms": 190 } },
		{ "nome": "sem escudo tira dos dois", "desafios": ["sem_escudo"],
			"esperado": { "lado_jogador.equipamento.escudo": null, "lado_rival.equipamento.escudo": null, "lado_jogador.equipamento.lanca.poder": 5, "lado_rival.equipamento.elmo.defesa": 16 } },
		{ "nome": "cavalo emprestado troca o cavalo do jogador", "desafios": ["cavalo_emprestado"],
			"esperado": { "lado_jogador.cavalo.velocidade": 55, "lado_jogador.cavalo.temperamento": 30, "lado_rival.cavalo.velocidade": 60 } },
		{ "nome": "uma chance com noite", "desafios": ["uma_chance", "noturna"],
			"esperado": { "cfg.mira.oscilacao.amplitude_px": 6, "perfil_rival.erro_mira_px": 13, "cfg.galope.galope.janela_base_ms": 70 } },
		{ "nome": "chuva e sem escudo", "desafios": ["chuva", "sem_escudo"],
			"esperado": { "cfg.galope.galope.janela_max_ms": 126, "lado_rival.equipamento.escudo": null } }
	],
	"perfil": [
		{ "nome": "soma numeros e troca textos", "perfil": { "erro_mira_px": 9, "reacao_media_ms": 190, "zona_preferida": "peito" },
			"ajuste": { "erro_mira_px": -3, "zona_preferida": "capacete" }, "esperado": { "erro_mira_px": 6, "reacao_media_ms": 190, "zona_preferida": "capacete" } },
		{ "nome": "nao passa de zero", "perfil": { "erro_mira_px": 4 }, "ajuste": { "erro_mira_px": -10 }, "esperado": { "erro_mira_px": 0 } }
	],
	"ia_perfil_rival": {
		"perfis": { "x": { "largada_perfeita_milesimos": 300, "largada_boa_milesimos": 550, "erro_mira_px": 9, "zona_preferida": "peito" } },
		"ajuste_campeao": { "_nota": "nota", "largada_perfeita_milesimos": 200, "largada_boa_milesimos": -100 }
	},
	"perfil_rival": [
		{ "nome": "rival comum: so o perfil_ajuste", "rival": { "perfil": "x", "perfil_ajuste": { "erro_mira_px": -3 } },
			"esperado": { "largada_perfeita_milesimos": 300, "largada_boa_milesimos": 550, "erro_mira_px": 6, "zona_preferida": "peito" } },
		{ "nome": "campeao soma ajuste_campeao e depois o dele", "rival": { "perfil": "x", "campeao": true, "perfil_ajuste": { "largada_perfeita_milesimos": 60, "zona_preferida": "capacete" } },
			"esperado": { "largada_perfeita_milesimos": 560, "largada_boa_milesimos": 450, "erro_mira_px": 9, "zona_preferida": "capacete" } },
		{ "nome": "campeao sem perfil_ajuste", "rival": { "perfil": "x", "campeao": true },
			"esperado": { "largada_perfeita_milesimos": 500, "largada_boa_milesimos": 450, "erro_mira_px": 9, "zona_preferida": "peito", "_nota": null } }
	]
}
